// dim_blue to cloud_white
datasource db {
  provider     = "mongodb"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid()) @map("_id")
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Product {
  id          String   @id @default(cuid()) @map("_id")
  name        String
  description String?
  price       Float
  stock       Int      @default(0)
  status      ProductStatus @default(DRAFT)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  productId String
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime @default(now())
  endDate   DateTime?
  product   Product  @relation(fields: [productId], references: [id])
  // user      User     @relation(fields: [userId], references: [id]) // Uncomment when linking
}

enum Role {
  USER
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

// NextAuth Models
model Account {
  id                 String  @id @default(cuid()) @map("_id")
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid()) @map("_id")
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// CMS Models for Portfolio
model HeroSection {
  id          String   @id @default(cuid()) @map("_id")
  heading     String
  subheading  String
  ctaText     String?
  ctaLink     String?
  imageUrl    String?
  updatedAt   DateTime @updatedAt
}


model PortfolioProject {
  id          String   @id @default(cuid()) @map("_id")
  title       String
  description String
  tags        String  // Stored as comma-separated values or JSON
  link        String?
  image       String?
  colSpan     Int      @default(1)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model Service {
  id          String   @id @default(cuid()) @map("_id")
  displayId   String
  title       String
  description String
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
}


model TechItem {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  icon      String?
  order     Int      @default(0)
}

model AboutSection {
  id          String   @id @default(cuid()) @map("_id")
  bio         String
  avatarUrl   String?
  resumeLink  String?
  experience  String? // JSON or rich text
  updatedAt   DateTime @updatedAt
}

model Certificate {
  id          String   @id @default(cuid()) @map("_id")
  title       String
  issuer      String
  date        DateTime
  imageUrl    String?
  credentialUrl String?
  createdAt   DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ContactInfo {
  id        String   @id @default(cuid()) @map("_id")
  mobile    String?
  email     String?
  address   String?
  linkedin  String?
  instagram String?
  github    String?
  whatsapp  String?
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id               String   @id @default(cuid()) @map("_id")
  siteName         String   @default("Next-Gen Platform")
  siteDescription  String?
  seoKeywords      String?
  maintenanceMode  Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}

model InstagramPost {
  id         String   @id @default(cuid()) @map("_id")
  imageUrl   String
  caption    String?
  postUrl    String?
  likes      Int      @default(0)
  comments   Int      @default(0)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}

